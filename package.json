{
  "name": "gmail-desktop",
  "productName": "Gmail",
  "version": "1.0.1",
  "description": "Cliente de escritorio ligero y elegante para Gmail",
  "homepage": "https://github.com/e-slzr/gmail-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/e-slzr/gmail-desktop.git"
  },
  "author": "Eliu Salazar <eliu.asalazar@gmail.com>",
  "main": "src/main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dist": "electron-builder --linux AppImage deb --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:win:zip": "electron-builder --win zip --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:mac:zip": "electron-builder --mac zip --publish never",
    "dist:all": "electron-builder -mwl --publish never"
  },
  "keywords": [
    "gmail",
    "desktop",
    "email",
    "client",
    "electron"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.4.1"
  },
  "build": {
    "appId": "com.eslzr.gmail-desktop",
    "productName": "Gmail",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Eliu Salazar <eliu.asalazar@gmail.com>",
      "category": "Network;Email",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "identity": null
    },
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "assets/**/*"
    ]
  }
}
